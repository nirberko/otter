  "findings": [
    {
      "id": "MCP-TOXIC-FLOW-001",
      "severity": "high",
      "category": "toxic-flow",
      "title": "Lethal trifecta: untrusted input + private data + external sink",
      "detail": "Server \"mcp\" exposes tools that together enable an exfiltration flow. Untrusted content: search_calls, get_transcript, list_voicemails, get_voicemail, search_messages, get_thread, list_team, get_product_note, subscribe_events, get_notification_preferences, ask_support, read_support · Private data: search_calls, search_contacts, send_message, get_account, port_requirements, get_account_balance, list_wallet_activity, list_wallet_refunds · Public sink: search_messages, send_message, list_team, discover_services, upsert_menu, submit_product_note, uk_divert_number, port_requirements, ask_support · Destructive: get_account, account_closure_options, delete_account_steps, run_esim_connection_check.",
      "evidence": {
        "source": "server:mcp",
        "snippet": "Untrusted content: search_calls, get_transcript, list_voicemails, get_voicemail, search_messages, get_thread, list_team, get_product_note, subscribe_events, get_notification_preferences, ask_support, read_support · Private data: search_calls, search_contacts, send_message, get_account, port_requirements, get_account_balance, list_wallet_activity, list_wallet_refunds · Public sink: search_messages, send_message, list_team, discover_services, upsert_menu, submit_product_note, uk_divert_number, port_requirements, ask_support · Destructive: get_account, account_closure_options, delete_account_steps, run_esim_connection_check"
      },
      "confidence": 0.6,
      "remediation": "Do not co-install these capabilities under one trust boundary; an injected comment/email can steer the model to exfiltrate via the sink tool."
    }
  ],
