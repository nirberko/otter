    {
      "id": "MCP-TOXIC-FLOW-001",
      "severity": "high",
      "category": "toxic-flow",
      "title": "Lethal trifecta: untrusted input + private data + external sink",
      "detail": "Server \"mcp\" exposes tools that together enable an exfiltration flow. Untrusted content: browse_feed, read_niche, list_posts_to_read, check_post, list_comments_to_hide, record_comments, list_library, list_scheduled_posts, read_comments, list_comments · Private data: mark_signed_in, set_video_privacy, record_post_metrics, record_radar_finds, mark_comment_hidden, record_comments, record_account_stats, send_to_photos, record_signed_in_accounts · Public sink: paste_post_text, record_post_metrics, report_post_result, check_post, list_replies_to_send, upload_media, finish_upload, schedule_post, cancel_scheduled_post, list_library, send_to_photos, start_scheduled_post, send_reply.",
      "evidence": {
        "source": "server:mcp",
        "snippet": "Untrusted content: browse_feed, read_niche, list_posts_to_read, check_post, list_comments_to_hide, record_comments, list_library, list_scheduled_posts, read_comments, list_comments · Private data: mark_signed_in, set_video_privacy, record_post_metrics, record_radar_finds, mark_comment_hidden, record_comments, record_account_stats, send_to_photos, record_signed_in_accounts · Public sink: paste_post_text, record_post_metrics, report_post_result, check_post, list_replies_to_send, upload_media, finish_upload, schedule_post, cancel_scheduled_post, list_library, send_to_photos, start_scheduled_post, send_reply"
      },
      "confidence": 0.6,
      "remediation": "Do not co-install these capabilities under one trust boundary; an injected comment/email can steer the model to exfiltrate via the sink tool."
