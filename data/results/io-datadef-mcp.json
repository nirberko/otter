  "tools": [
    {
      "name": "get_design_guide",
      "descriptionHash": "e1fe7b9fa84d3c7f4716fd3c91e18367f7c64ade1b8f27901bcb325a8bc339e2",
      "description": "Datadef's standard for what makes a diagram readable, size, edge discipline, nested zones, annotations, and the tool order for building or editing. Read this BEFORE your first canvas_* call. It is the same standard Datadef's own generator follows, so a diagram you build by hand comes out indistingui"
    },
    {
      "name": "canvas_describe_canvas",
      "descriptionHash": "0d740b8f230db304c37c7ff90a2c2642cf4a1c213ab4197b6be249ed768e63a5",
      "description": "Get an overview of the current canvas: every node with its id, type, label and group, plus all connections and groups. Call this first, before any edit, so you work from real node ids instead of guesses.\n\nOperates on one Datadef diagram, named by diagram_id.\n\nIf you have not already, call get_design"
    },
    {
      "name": "canvas_inspect_nodes",
      "descriptionHash": "50ea2f70d05cc716fc407a99922baa34c9a32b6402e7799a3215cbca2aeacd33",
      "description": "Get full detail for specific nodes: all columns with types and keys, metadata, schedule, formula, owners. Use before modifying a node so you preserve fields you are not changing.\n\nOperates on one Datadef diagram, named by diagram_id."
    },
    {
      "name": "canvas_measure_canvas",
      "descriptionHash": "9f17da0e5fd0cdab3830ced81a3c991f6be614cd5fdbeec3f0ea1709d3368e6b",
      "description": "Get exact geometry: every node's position and size in canvas units, the overall canvas bounds, and any nodes that overlap each other. Call this before moving, resizing, or placing anything precisely — positions are meaningless without it.\n\nOperates on one Datadef diagram, named by diagram_id."
    },
    {
      "name": "canvas_suggest_simplifications",
      "descriptionHash": "94ddddc890cde43de8e20af1742c5fc8f39b6bc04e00e37fac30ba4a4d3561ef",
      "description": "Report where this canvas could be collapsed — groups of similar nodes that could become one summary node — without changing anything. Use it to decide whether the diagram is denser than it needs to be. Density is not automatically a problem: keep the detail when the detail is the point.\n\nOperates on"
    },
    {
      "name": "canvas_search_icons",
      "descriptionHash": "b20e27c842878e5a025df81d20d5c7e81a8ab9bde012b8a5e1e04f0b5b5e7f02",
      "description": "Search Datadef's icon library (2000+ cloud and data-tool logos) for a valid icon id. Use it when you want a specific vendor logo and are unsure of its exact id — passing an invalid id silently falls back to a generic icon.\n\nOperates on one Datadef diagram, named by diagram_id."
    },
    {
      "name": "canvas_add_nodes",
      "descriptionHash": "9269882bed74ccef35c8b7200a2daf9d089f5d7e39dc12cc7222fe9b37adca3a",
      "description": "Add one or more nodes to the canvas. Batch every node you want in a single call. Positions are assigned by canvas_layout_canvas afterwards — never set them yourself.\n\nOperates on one Datadef diagram, named by diagram_id.\n\nIf you have not already, call get_design_guide first: it carries Datadef's siz"
    },
    {
      "name": "canvas_add_standalone_node",
      "descriptionHash": "f48ff73116965b9e1eb9abf2143008db90344ce11033366e8aa9ae7a14930a86",
      "description": "Add a single data node at an exact position, without connecting it to anything. Use when the user wants something placed somewhere specific, or when you will wire it up yourself afterwards. For building out a connected diagram, canvas_add_nodes is better — it batches and lets layout position everyth"
    },
    {
      "name": "canvas_update_nodes",
      "descriptionHash": "5dc5bd5db3a91112f766f13cdd47ed937e931851a895c6af5243c69bdb3f23e3",
      "description": "Change properties of existing nodes. Only the fields you pass are touched; everything else is preserved. To replace a table's columns use canvas_set_columns instead.\n\nOperates on one Datadef diagram, named by diagram_id."
    },
    {
      "name": "canvas_replace_node",
      "descriptionHash": "c036b4f49c772e8b4dd942e169f030d9b7ee4e81c3ac36f15030c66fa8f31d57",
      "description": "Swap a node for a different one while keeping every connection, its position, and its group. Use this when a component changes — Redshift becomes Snowflake, a batch job becomes streaming — instead of deleting and rebuilding, which would lose all the edges.\n\nOperates on one Datadef diagram, named by "
    },
    {
      "name": "canvas_remove_nodes",
      "descriptionHash": "296d7ce2e01b5757dffaa6c93aecddf40bf0b8967bca65951a7928a99d757ce7",
      "description": "Delete nodes and every edge touching them. Deleting a group also deletes the nodes inside it — check with canvas_describe_canvas first if that is not what you want.\n\nOperates on one Datadef diagram, named by diagram_id.",
      "labels": [
        "destructive"
      ]
    },
    {
      "name": "canvas_connect_nodes",
      "descriptionHash": "e7d901c2a6bedf61c207834072b6214553519889eec2455a2d83866ced29afe9",
      "description": "Draw edges between nodes to show how data flows. Always label the edge with what actually happens (\"ingest\", \"dbt transform\", \"hourly sync\") — unlabelled edges make a diagram useless.\n\nOperates on one Datadef diagram, named by diagram_id."
    },
    {
      "name": "canvas_update_edges",
      "descriptionHash": "7288aadb3894e793f52251edb4e153892cde3bd9533c3598d97c899e250802ab",
      "description": "Change existing connections without deleting them: fix a label, change the type, or restyle. Use this to correct a wrong edge label rather than disconnecting and reconnecting.\n\nOperates on one Datadef diagram, named by diagram_id."
    },
    {
      "name": "canvas_disconnect_nodes",
      "descriptionHash": "f373b85676e322ffc913f9ff19c58116a7f97b23d6801a0372e40ab2c9e39a89",
      "description": "Remove the edge between two nodes.\n\nOperates on one Datadef diagram, named by diagram_id.",
      "labels": [
        "destructive"
      ]
    },
    {
      "name": "canvas_set_columns",
      "descriptionHash": "1a9cbe5a272c0c2b45e122c1f57c2ea0a585a426d7980c479fa869114443e225",
      "description": "Set the full column list of a table node, replacing whatever it had. Pass every column you want to keep — this is a replace, not a merge. Mark primary and foreign keys; they are what make a data diagram worth reading.\n\nOperates on one Datadef diagram, named by diagram_id."
    },
    {
      "name": "canvas_group_nodes",
      "descriptionHash": "d131a07a77cd0f0cec1dfc70143513cd5a71262402834ef2257861304f2a5097",
      "description": "Create a labelled zone (e.g. \"Bronze Layer\", \"Ingestion\") and optionally move nodes into it. Zones are what turn a tangle of boxes into a readable architecture — use them for layers, domains, or environments.\n\nOperates on one Datadef diagram, named by diagram_id.\n\nIf you have not already, call get_d"
    },
    {
      "name": "canvas_move_to_group",
      "descriptionHash": "6ef70edd8bf2137853c8d2f37caac2880f02998f20960a32113222cb14e4b26b",
      "description": "Move existing nodes into an existing group, or out of any group.\n\nOperates on one Datadef diagram, named by diagram_id."
    },
    {
      "name": "canvas_add_lineage",
      "descriptionHash": "25ed925daea58a9ff72f5e692d043d516c62b9c0c198038d4a61cf1fb4c949dd",
      "description": "Record column-level lineage: which source column produces which target column, and how. This is what makes the diagram queryable for impact analysis, so add it for every real transformation.\n\nOperates on one Datadef diagram, named by diagram_id.",
      "labels": [
        "private-data"
      ]
    },
    {
      "name": "canvas_add_text",
      "descriptionHash": "a87e716251031e6a164fc9f75e3db03e7e4f2b16f4c68ecdb6a0b6196bc308dc",
      "description": "Place a free-floating text box on the canvas — a caption, a callout, a section heading, a note explaining a decision. Position it with explicit coordinates from canvas_measure_canvas. Text boxes are annotations: they are not part of the data flow and take no edges.\n\nOperates on one Datadef diagram, "
    },
    {
      "name": "canvas_add_shape",
      "descriptionHash": "9ef69fc60502842a5b94272c8651d3b5463e173f5c896df8e491986bd2ea9f2a",
      "description": "Place a rectangle, circle, arrow, or line as a visual annotation — a backdrop highlighting a region, an arrow pointing something out, a divider. Shapes sit behind data nodes and are not part of the data flow. To group nodes into a labelled zone use canvas_group_nodes instead.\n\nOperates on one Datade"
    },
    {
      "name": "canvas_add_flow_arrow",
      "descriptionHash": "f9a17c1adf61278dbbc7653d173950a5947ab51fb0ece11362794c5fb711728c",
      "description": "Draw one large labelled arrow representing a whole flow — \"ingest\", \"serve\", \"publish\" — instead of many thin edges saying the same thing. Use this when several things move the same way for the same reason: draw the arrow once between the two areas rather than connecting every pair. This is a visual",
      "labels": [
        "public-sink"
      ]
    },
    {
      "name": "canvas_add_region",
      "descriptionHash": "1cd58b954f649207ba5748a38c0a24f750819d819182437067a0073fb80032be",
      "description": "Draw a labelled translucent area behind existing nodes to show they belong together, without reparenting them. Use this when the grouping is a reading aid rather than real containment, when areas would need to overlap, or when a node belongs to two ideas at once — canvas_group_nodes cannot express a"
    },
    {
      "name": "canvas_move_nodes",
      "descriptionHash": "3cc56e5b39c9b50eabc39bbffad920231082a2ca71d2ad2ffa5c7c77fcb43866",
      "description": "Set node positions precisely. Use absolute x/y to place something exactly, or dx/dy to nudge it. Coordinates are absolute canvas units (same space canvas_measure_canvas reports). Moving a group moves its children with it — do not also move those children in the same call. Call canvas_measure_canvas "
    },
    {
      "name": "canvas_resize_nodes",
      "descriptionHash": "2528eb129ebcb4594e8707027db771d5feff422777776bdc47b9a98f7da5e805",
      "description": "Set the width and height of nodes. Mostly for shapes, text boxes, and group zones — data nodes size themselves from their content, and resizing one can clip what it displays.\n\nOperates on one Datadef diagram, named by diagram_id."
    },
    {
      "name": "canvas_align_nodes",
      "descriptionHash": "5b20bc13911d8dd33e74cfb916628188ebbad863d23e5943a33b42934ff1b114",
      "description": "Align nodes to a shared edge or centre line, or space them evenly. Cleaner and far more reliable than computing coordinates by hand.\n\nOperates on one Datadef diagram, named by diagram_id."
    },
    {
      "name": "canvas_collapse_nodes",
      "descriptionHash": "c3a468d8399999e10b51e9ecd6d6b1855df156ac9ea8d5380a366d5fd5ec7adb",
      "description": "Merge several nodes into one summary node, keeping every connection. Use when a set of near-identical objects adds length without adding meaning — eight staging models that all behave the same become \"stg_* (8)\". Do not use when the individual objects are what the reader came for.\n\nOperates on one D"
    },
    {
      "name": "canvas_layout_canvas",
      "descriptionHash": "3be42a754bf0aea220ff995e50b4e51347a8e018a72a4238d74b16f8070e03f6",
      "description": "Arrange the canvas. Call this once at the end, after all structural edits are done — not between each edit. By default only the parts you touched are re-arranged and everything else keeps its position.\n\nOperates on one Datadef diagram, named by diagram_id."
    },
    {
      "name": "canvas_validate_canvas",
      "descriptionHash": "bf24816c13cd6c1c86fb6d7f4f6828f84c08560f9e512331b4687660cd8d8086",
      "description": "Check the canvas for structural problems (disconnected nodes, circular data flow, broken references) and quality problems (unlabelled edges, tables without columns). Call this before you finish, and fix any errors it reports.\n\nOperates on one Datadef diagram, named by diagram_id."
    },
    {
      "name": "create_diagram",
      "descriptionHash": "5de514e2aa12773e890ea51545d5e65ed7599c00b7061850b6a514528492d4ae",
      "description": "Generate a professional data architecture diagram from a description and save it to the user's Datadef account.\n\nUse this for any data-shaped diagram: medallion and lakehouse architectures, ETL/ELT pipelines, streaming topologies, data mesh, star and snowflake schemas, ER diagrams, lineage maps, clo",
      "labels": [
        "private-data"
      ]
    },
    {
