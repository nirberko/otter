      "descriptionHash": "b68f7112597c0835d0a2d90c905a26860e3fe1eaa87e7ca06abebb0f809f5f7f",
      "description": "Create an empty diagram and return its diagram_id, so you can build it yourself with the canvas_* tools. No AI generation runs and no credit is spent: you draw it.\n\nUse this when you want control over the result, or already know the architecture from the conversation. Use create_diagram instead when"
    },
    {
      "name": "list_diagrams",
      "descriptionHash": "1989617e3d57b4a2f487c3e45e8f8cf334662b97b38091ce0e72ccd6a4057e63",
      "description": "List diagrams in the user's Datadef account, most recently updated first. Use this to find the id of a diagram before editing or exporting it."
    },
    {
      "name": "get_diagram",
      "descriptionHash": "11a84f27b6c317575e9a493f40d76c67464de3889482500f7334d20e151d3b33",
      "description": "Read the full structure of a diagram: every node with its type and columns, every connection, and the groups. Use this before editing so you know what is actually there."
    },
    {
      "name": "edit_diagram",
      "descriptionHash": "a469a666d42d9f2bdf178b2849ea5c89d1eac70fa7c793aeefabe39355d42d4b",
      "description": "Change an existing diagram with a natural-language instruction, add nodes, rewire connections, add columns, reorganise into layers, fill in owners and schedules.\n\nBe specific about what to change and where. \"Add a Kafka topic between the API and the bronze table, labelled 'events'\" works; \"make it b"
    },
    {
      "name": "export_diagram",
      "descriptionHash": "0160814e7c101c0cf9df106041758eda32e29b15cadb604302428c9e551b8728",
      "description": "Render a diagram to a PNG or JPEG image. Returns the image inline AND a short-lived signed download URL. Use the inline image to show the diagram; use the URL when the user wants to save it, attach it, or share a link: it serves the file directly and needs no API key.",
      "labels": [
        "private-data",
        "public-sink"
      ]
    },
    {
      "name": "repo_status",
      "descriptionHash": "08950f03a7962498d15c682d9be37f1c24d592db9821461b98b89ed6a63f39a4",
      "description": "For a diagram that was created from a connected git repository: which repo and branch or tag it tracks, when it last synced, the commit it reflects, and whether daily sync is on. Use repo_refresh to sync it now. Only the owner of the repository connection can use this."
    },
    {
      "name": "repo_refresh",
      "descriptionHash": "5097a81716768bdb7323a6af7ee04d4e09f8a1f4bc48621ecdcafc9a258266dc",
      "description": "Re-sync a repo-linked diagram from the current state of its repository. If the tracked branch or tag has not moved since the last sync, nothing changes. If it has, the diagram is REGENERATED from the repository, which replaces manual canvas edits. Only the owner of the repository connection can use "
    }
