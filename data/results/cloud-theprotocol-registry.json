    {
      "name": "theprotocol_verifyPayment",
      "descriptionHash": "a1f4765db7da33fdbfa81ac470b84645011c6d20a048866b9883c27e1e3a5176",
      "description": "Verify an A2A payment token before doing paid work. Returns validity + amount + caller_did + target_agent_did. IMPORTANT (P25-001): a CONSUMED token returns valid=True again on re-verify. Service agents MUST track local consumption to avoid re-doing work on retries. Requires agent JWT (any agent — t",
      "labels": [
        "private-data"
      ]
