      "evidence": {
        "source": "server:mcp",
        "snippet": "Untrusted content: find_similar_opinions, get_opinion, get_statute, find_agency_policies · Private data: search_case_names, search_opinion_text, search_by_concept, find_similar_opinions, resolve_citation, get_opinion, get_citation_graph, get_parentheticals, get_negative_history, check_brief, find_opinions_citing_statute, find_agency_policies, count_deadline, describe_sources · Public sink: search_statute_text, find_agency_policies, count_deadline · Destructive: search_statute_text"
      },
      "confidence": 0.6,
      "remediation": "Do not co-install these capabilities under one trust boundary; an injected comment/email can steer the model to exfiltrate via the sink tool."
