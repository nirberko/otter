    {
      "name": "validate_iban",
      "descriptionHash": "b6a53805c541a143ae7317bc812a668df571a16021c418b1cbaf140ce9f4f767",
      "description": "Validate an IBAN. Checks the country's length from the IBAN registry and the mod 97-10 check digits. Returns the country, check digits, BBAN and the standard 4-character grouping. A wrong check digit or length comes back as valid:false with the reason. Nothing is stored."
    },
    {
      "name": "validate_bic",
      "descriptionHash": "48d0b249637c129b60e6f1cfd8e0828500691b037196c3d7447ee7120d002097",
      "description": "Validate a BIC / SWIFT code. Checks the shape and ISO country, and splits the code into institution, country, location and branch. Also gives the 8 and 11-character forms and flags test BICs. Format only: it does not say whether the bank exists. Nothing is stored.",
      "labels": [
        "destructive"
      ]
    },
    {
      "name": "validate_routing_number",
      "descriptionHash": "fca1ba014c8db191aef67bdaec0a8a3173abf1bec9f093049da70dfc870077c9",
      "description": "Validate a US ABA routing number. Checks the 3-7-1 checksum and returns the institution type from the prefix and the Federal Reserve district. It does not look up the bank's name. Nothing is stored."
    },
    {
      "name": "validate_gtin",
      "descriptionHash": "41c107097c51e31699389b2e625e821a1d2f0354696d9797837c4d026d9e314a",
      "description": "Validate a UPC, EAN, GTIN or ISBN-13. Checks the GS1 check digit and names the format (UPC-A, EAN-13, EAN-8, GTIN-14). When the digit is wrong it returns the digit it should be. Notes ISBN and ISSN prefixes. It does not look the product up. Nothing is stored.",
      "labels": [
        "destructive"
      ]
    },
    {
      "name": "validate_vin",
      "descriptionHash": "f8526dfb6907081cc2036fdd999ffa947117cb08807cfb2de34109d07c1db892",
      "description": "Validate and decode a VIN. Checks length, the forbidden letters I, O and Q, and the position-9 check digit (required for North America, informational elsewhere). Returns the region, model year, manufacturer code, plant code and serial. It does not look up the make or model. Nothing is stored."
    },
    {
      "name": "validate_email",
      "descriptionHash": "9d9d7aff903a74d569ab5ad32371924efb0bf591410e760cc886e27f6be4c38f",
      "description": "Check an email address. Checks syntax (including international domains), flags disposable, role (info@, support@) and webmail-provider addresses, suggests a fix for common typos like gmial.com, and looks up the domain's mail records. It never contacts the mailbox, so it cannot confirm that an addres",
      "labels": [
        "untrusted-content",
        "private-data",
        "public-sink"
      ]
    },
